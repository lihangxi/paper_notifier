FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_TYPE=bot
FLOW_FIELD_TITLE=paper_title
FLOW_FIELD_AUTHORS=authors
FLOW_FIELD_DESCRIPTION=summary
FLOW_SINGLE_SUMMARY=true
# When FLOW_SINGLE_SUMMARY=true, only FLOW_FIELD_DESCRIPTION is used.
# FLOW_FIELD_TITLE and FLOW_FIELD_AUTHORS are only used when FLOW_SINGLE_SUMMARY=false.
QUERY=quantum computing
MAX_PAPERS=8
DAYS_BACK=1
RESEARCH_FIELD_TERMS=quantum computing,quantum,qubit,superconducting qubit
LLM_RELEVANCE_TOPIC=quantum computing
LLM_RELEVANCE_SCORE_THRESHOLD=0.70
SUMMARY_LLM_ENABLED=true
KEYWORD_LLM_ENABLED=true
IMPACT_GENERATION_ENABLED=true
# SUMMARY_LLM_ENABLED controls LLM summary generation.
# KEYWORD_LLM_ENABLED controls LLM concept-keyword generation.
# IMPACT_GENERATION_ENABLED controls whether summary includes an Impact sentence.
KEYWORDS_FILE=keywords.txt
LOG_FILE=logs/matched_papers.log
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_LIMIT=20
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENROUTER_TIMEOUT_SECONDS=25
OPENROUTER_RETRY_LIMIT=10
OPENROUTER_RETRY_INTERVAL_SECONDS=60

RSS_FEEDS=
TIMEZONE=Asia/Shanghai
RUN_TIME=09:00
SCHEDULER_MISFIRE_GRACE_SECONDS=60
CROSSREF_MAILTO=
CROSSREF_ROWS=5
