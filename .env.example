SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_USERNAME=paper-notifier
SLACK_ICON_EMOJI=:newspaper:
QUERY=quantum computing
MAX_PAPERS=8
DAYS_BACK=1
RESEARCH_FIELD_TERMS=quantum computing,quantum,qubit,superconducting qubit
LLM_RELEVANCE_TOPIC=quantum computing
LLM_RELEVANCE_SCORE_THRESHOLD=0.70
SUMMARY_LLM_ENABLED=true
KEYWORD_LLM_ENABLED=true
IMPACT_GENERATION_ENABLED=true
# SUMMARY_LLM_ENABLED controls LLM summary generation.
# KEYWORD_LLM_ENABLED controls LLM concept-keyword generation.
# IMPACT_GENERATION_ENABLED controls whether summary includes an Impact sentence.
KEYWORDS_FILE=keywords.txt
# Set false to skip the keywords.txt filter entirely (e.g. when KB relevance handles filtering).
KEYWORDS_FILTER_ENABLED=true
LOG_FILE=logs/matched_papers.log
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_LIMIT=20
LLM_PROVIDER=openrouter

# --- Official DeepSeek platform (OpenAI-compatible). ----------------------
# Switch to DeepSeek by setting LLM_PROVIDER=deepseek plus a key from
# https://platform.deepseek.com. deepseek-chat takes no thinking/effort params.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_REASONING_EFFORT=

# --- OpenRouter (used when LLM_PROVIDER is openrouter or unset) ------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# --- Shared LLM request settings (retries/timeouts) -----------------------
OPENROUTER_TIMEOUT_SECONDS=25
OPENROUTER_RETRY_LIMIT=10
OPENROUTER_RETRY_INTERVAL_SECONDS=60

RSS_FEEDS=
TIMEZONE=Europe/Stockholm
RUN_TIME=09:00
SCHEDULER_MISFIRE_GRACE_SECONDS=60
CROSSREF_MAILTO=
CROSSREF_ROWS=5

# --- Knowledge-base relevance (optional, replaces the LLM topic relevance filter) ---
# When enabled, today's papers are scored against your Zotero library using free,
# open-source local models (sentence-transformers). Requires `pip install -e ".[kb]"`.
KB_RELEVANCE_ENABLED=false
# Zotero Web API. Create a key at https://www.zotero.org/settings/keys and set your
# numeric user id (shown on the same page). For a shared group library set ZOTERO_GROUP_ID.
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_GROUP_ID=
# Alternative: local Zotero API (no key needed, reads local database). Requires the
# Zotero desktop app running with the local API enabled. Use:
#   ZOTERO_API_BASE=http://localhost:23119/api
#   ZOTERO_USER_ID=0
ZOTERO_API_BASE=https://api.zotero.org
# Optional: comma-separated Zotero collection keys to restrict the library snapshot.
ZOTERO_COLLECTION_KEYS=
# Cache dir for the Zotero item snapshot and precomputed embeddings.
ZOTERO_CACHE_DIR=kb_cache

# --- Scoring models (CPU-friendly defaults; swap for GPU models if available) ---
# CPU default: BAAI/bge-base-en-v1.5. GPU quality option: Qwen/Qwen3-Embedding-4B (or 8B).
KB_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Optional sentence-transformers prompt applied to the paper (query) side.
# Set to `query` when using Qwen3-Embedding models (+1-5% retrieval); leave empty for BGE.
KB_QUERY_PROMPT=
# CPU default: BAAI/bge-reranker-base. GPU quality option: Qwen/Qwen3-Reranker-4B.
KB_RERANKER_MODEL=BAAI/bge-reranker-base
# Cross-encoder reranker: informational only (its sigmoid scores are uncalibrated
# for absolute gating), so it is off by default. Decision uses embedding cosine.
KB_RERANKER_ENABLED=false
# Show the best-matching library item + score in each Slack paper entry.
KB_SHOW_IN_SLACK=true
# Number of best-matching library items reported per paper.
KB_TOP_K=20
# Keep a paper when its best library match reaches this embedding-cosine value (0.0-1.0).
# Calibrated from a real run: relevant ~0.75-0.85, unrelated news/biology <0.70.
KB_SCORE_THRESHOLD=0.75
# Device: auto (cuda if present, else cpu), cpu, or cuda.
KB_DEVICE=auto
KB_BATCH_SIZE=32
# Hugging Face model cache location for the KB models. Empty = default user cache
# (~/.cache/huggingface). Set e.g. kb_cache/hf to keep models inside the project.
KB_HF_HOME=
# true = load the KB models strictly from the local cache with ALL Hugging Face
# network access disabled. Run `python -m paper_notifier.cli --fetch-kb-models`
# once first to populate the cache (or simply leave false to allow downloads).
KB_LOCAL_FILES_ONLY=false
